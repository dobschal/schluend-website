<!doctype html>
<html lang="de">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0"/>
    <meta name="description"
          content="SCHLÜNDs Musik ist wie ein Schlag in die Magengrube: hart, dreckig und von bleibendem Eindruck.">
    <meta property="og:title" content="SCHLÜND">
    <meta property="og:site_name" content="SCHLÜND">
    <meta property="og:url" content="https://schluend.fun">
    <meta property="og:description"
          content="SCHLÜNDs Musik ist wie ein Schlag in die Magengrube: hart, dreckig und von bleibendem Eindruck.">
    <meta property="og:type" content="music.musician">
    <meta property="og:image" content="https://schluend.fun/2025-schlund.png">
    <title>Schlünd</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <script>
        async function load(url) {
            const rawResponse = await fetch(url);
            return await rawResponse.json();
        }

        function render(target, template) {
            const el = document.createElement("div");
            el.innerHTML = template;
            document.querySelector(target).appendChild(el.children[0]);
        }

        function ensureValidJson(json) {
            try {
                JSON.parse(json);
                return true;
            } catch (e) {
                return false;
            }
        }
    </script>
    <link rel="stylesheet" href="/build/style.css">
</head>
<body>

<!-- region: First Page -->
<section>
    <h1>Schlünd</h1>
    <nav>
        <a href="/">SCHLÜND</a>
        <a href="#music">Musik</a>
        <a href="#concerts">Konzerte</a>
        <a href="#photos">Fotos</a>
        <a href="#recommendations">Stimmen</a>
        <a href="#blog">Blog</a>
        <a href="#concerts">Booking</a>
    </nav>
    <div class="social-media-items">
        <a href="https://open.spotify.com/intl-de/artist/3aF61CJZtup6Mkpg99iwnf?si=69kRHWe-QBejv0eOGtd-0A"
           target="_blank" id="spotify">Spotify</a>
        <a href="https://music.apple.com/de/artist/schlund/1439601530" target="_blank" id="apple-music">Apple Music</a>
        <a href="https://www.youtube.com/channel/UCMBq97nCVyhmniwB4WDTnYg?app=desktop" target="_blank" id="youtube">YouTube</a>
        <a href="https://www.instagram.com/schluend.band/" target="_blank" id="instagram">Instagram</a>
        <a href="https://schluend.bandcamp.com/album/splitt-ep" target="_blank" id="bandcamp">Bandcamp</a>
    </div>
    <div class="hero-image-with-text">
        <img class="hero-image" src="/2025-schlund.png" alt="SCHLÜND">
        <p>
            SCHLÜNDs Musik ist wie ein Schlag in die Magengrube: hart, dreckig und von bleibendem
            Eindruck. Geprägt von intensiven Beats und hypnotischen Riffs, ist jeder Song eine
            Einladung, sich von festgefahrenen Strukturen zu befreien und der musikalischen
            Entfaltung hinzugeben.
            FFO: DŸSE, Turbostaat, Lessoner
        </p>
    </div>
</section>

<!-- endregion: First Page -->

<!-- region: Music -->

<section id="music">
    <h2>Musik</h2>
    <% for (const musicItem of musicItems) { %>
        <div>
            <img src="<%= musicItem.image %>" alt="<%= musicItem.title %>">
            <div>
                <h3><%= musicItem.title %></h3>
                <p>
                    <a href="<%= musicItem.spotify %>" target="_blank">Spotify</a> |
                    <a href="<%= musicItem.bandcamp %>" target="_blank">Bandcamp</a> |
                    Released on
                    <time datetime="<%= musicItem.releaseDate %>"><%= musicItem.releaseDate %></time>
                </p>
            </div>
        </div>
    <% } %>
</section>

<!-- endregion: Music -->

<!-- region concerts -->
<section id="concerts">
    <h2>Konzerte</h2>
    <% for(const concert of concerts) { %>
        <a href="<%= concert.link %>">
            <span><%= concert.date %></span>
            <span><%= concert.title %></span>
        </a>
    <% } %>
    <p>
        <b>Booking: </b> 👉 <a href="mailto:booking@schluend.fun">booking@schluend.fun</a>
    </p>
</section>

<!-- endregion concerts -->

<!-- region photos -->

<section id="photos">
    <h2>Fotos</h2>
    <div>
        <% for(const photo of photos) { %>
            <div style="background-image: url('<%= photo.file %>')"
                 data-lightbox="photos"
                 data-lightbox-src="<%= photo.file %>"
                 data-lightbox-caption="© <%= photo.author %>">
                <p>© <%= photo.author %></p>
            </div>
        <% } %>
    </div>
</section>

<!-- endregion photos -->

<!-- region recommendations -->

<section id="recommendations">
    <h2>Stimmen</h2>
    <% for(const recommendation of recommendations) { %>
        <blockquote>
            <p>"<%= recommendation.text %>"</p>
            <cite>— <%= recommendation.author %></cite>
        </blockquote>
    <% } %>
</section>

<!-- endregion recommendations -->

<!-- region blog -->

<section id="blog">
    <h2>Blog</h2>
    <% if (blogEntries.length > 1) { %>
        <div class="blog-header">
            <button class="blog-nav blog-prev" onclick="navigateBlog(-1)" aria-label="Previous entry" style="visibility: hidden;">&larr;</button>
            <div class="blog-indicators">
                <% blogEntries.forEach((entry, index) => { %>
                    <span class="blog-indicator<%= index === 0 ? ' active' : '' %>" data-index="<%= index %>" onclick="showBlogEntry(<%= index %>)"></span>
                <% }); %>
            </div>
            <button class="blog-nav blog-next" onclick="navigateBlog(1)" aria-label="Next entry">&rarr;</button>
        </div>
    <% } %>
    <div class="blog-entries">
        <% blogEntries.forEach((entry, index) => { %>
            <% const images = collectImages(entry); %>
            <article class="blog-entry<%= images.length ? ' has-image' : ' no-image' %>" data-index="<%= index %>" style="display: <%= index === 0 ? 'flex' : 'none' %>;">
                <% if (images.length) { %>
                    <div class="blog-images">
                        <div class="blog-image"
                             style="background-image: url('<%= images[0].full %>');"
                             data-lightbox="blog-<%= index %>"
                             data-lightbox-src="<%= images[0].full %>"
                             data-lightbox-caption="<%= entry.title %>"></div>
                        <% if (images.length > 1) { %>
                            <div class="blog-thumbs">
                                <% images.slice(1).forEach(image => { %>
                                    <div class="blog-thumb"
                                         style="background-image: url('<%= image.thumbnail %>');"
                                         data-lightbox="blog-<%= index %>"
                                         data-lightbox-src="<%= image.full %>"
                                         data-lightbox-caption="<%= entry.title %>"></div>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                <% } %>
                <div class="blog-content">
                    <time datetime="<%= entry.date %>"><%= formatDate(entry.date) %></time>
                    <h3><%= entry.title %></h3>
                    <div class="blog-text"><%- renderRichText(entry.content) %></div>
                </div>
            </article>
        <% }); %>
    </div>
</section>

<script>
    let currentBlogIndex = 0;
    const blogEntries = document.querySelectorAll('.blog-entry');
    const blogIndicators = document.querySelectorAll('.blog-indicator');
    const blogPrev = document.querySelector('.blog-prev');
    const blogNext = document.querySelector('.blog-next');
    const totalEntries = blogEntries.length;

    function updateNavVisibility() {
        if (!blogPrev || !blogNext) return; // Header fehlt, wenn es nur einen Eintrag gibt
        blogPrev.style.visibility = currentBlogIndex === 0 ? 'hidden' : 'visible';
        blogNext.style.visibility = currentBlogIndex === totalEntries - 1 ? 'hidden' : 'visible';
    }

    function showBlogEntry(index) {
        if (totalEntries === 0) return;
        if (index < 0 || index >= totalEntries) return;
        currentBlogIndex = index;
        blogEntries.forEach((entry, i) => {
            entry.style.display = i === currentBlogIndex ? 'flex' : 'none';
        });
        blogIndicators.forEach((indicator, i) => {
            indicator.classList.toggle('active', i === currentBlogIndex);
        });
        updateNavVisibility();
    }

    function navigateBlog(direction) {
        showBlogEntry(currentBlogIndex + direction);
    }
</script>

<!-- endregion blog -->

