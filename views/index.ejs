<!-- region lightbox -->

<div id="lightbox" class="lightbox" hidden>
    <button class="lightbox-close" aria-label="Schließen">&times;</button>
    <img class="lightbox-image" src="" alt="">
    <p class="lightbox-caption"></p>
    <span class="lightbox-counter"></span>
</div>

<script>
    (function () {
        const lightbox = document.getElementById('lightbox');
        const lightboxImage = lightbox.querySelector('.lightbox-image');
        const lightboxCaption = lightbox.querySelector('.lightbox-caption');
        const lightboxCounter = lightbox.querySelector('.lightbox-counter');
        const galleries = {};
        let gallery = [];
        let index = 0;
        let swiped = false;

        // Galerien einsammeln: alle Elemente mit gleichem data-lightbox gehören zusammen,
        // in DOM-Reihenfolge (Blog: großes Bild, dann Thumbnails).
        document.querySelectorAll('[data-lightbox]').forEach(element => {
            const name = element.dataset.lightbox;
            galleries[name] = galleries[name] || [];
            galleries[name].push({
                element,
                src: element.dataset.lightboxSrc,
                caption: element.dataset.lightboxCaption || ''
            });
        });

        document.addEventListener('click', event => {
            const trigger = event.target.closest('[data-lightbox]');
            if (!trigger) return;
            const items = galleries[trigger.dataset.lightbox] || [];
            const position = items.findIndex(item => item.element === trigger);
            if (position === -1) return;
            open(items, position);
        });

        function open(items, position) {
            gallery = items;
            index = position;
            show();
            lightbox.hidden = false;
            document.body.classList.add('lightbox-open');
        }

        function show() {
            const item = gallery[index];
            lightboxImage.src = item.src;
            lightboxImage.alt = item.caption;
            lightboxCaption.textContent = item.caption;
            lightboxCaption.hidden = !item.caption;
            lightboxCounter.textContent = (index + 1) + ' / ' + gallery.length;
            lightboxCounter.hidden = gallery.length < 2;
        }

        function step(direction) {
            index = (index + direction + gallery.length) % gallery.length;
            show();
        }

        function close() {
            lightbox.hidden = true;
            lightboxImage.src = '';
            document.body.classList.remove('lightbox-open');
        }

        lightbox.addEventListener('click', event => {
            if (swiped) { // Wisch-Gesten lösen auf manchen Geräten zusätzlich ein Klick-Event aus
                swiped = false;
                return;
            }
            // X-Button und der dunkle Rand schließen, ein Klick aufs Bild blättert weiter.
            if (event.target.closest('.lightbox-close') || event.target === lightbox) return close();
            if (gallery.length < 2) return close();
            step(1);
        });

        document.addEventListener('keydown', event => {
            if (lightbox.hidden) return;
            if (event.key === 'Escape') return close();
            if (event.key === 'ArrowRight') return step(1);
            if (event.key === 'ArrowLeft') return step(-1);
        });

        let touchStartX = null;
        lightbox.addEventListener('touchstart', event => {
            touchStartX = event.changedTouches[0].clientX;
        }, {passive: true});
        lightbox.addEventListener('touchend', event => {
            if (touchStartX === null) return;
            const distance = event.changedTouches[0].clientX - touchStartX;
            touchStartX = null;
            if (Math.abs(distance) < 40 || gallery.length < 2) return;
            swiped = true;
            step(distance < 0 ? 1 : -1);
        }, {passive: true});
    })();
</script>

<!-- endregion lightbox -->

</body>
</html>
